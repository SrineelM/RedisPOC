					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"channel\": \"news\",\n  \"message\": \"Breaking news at {{$timestamp}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/pubsub/publish",
							"host": ["{{base_url}}"],
