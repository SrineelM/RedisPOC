				}
			]
		},
		{
			"name": "9. Redis Streams",
			"item": [
				{
					"name": "Publish Order Event",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"orderId\": \"order-{{$randomInt}}\",\n  \"amount\": {{$randomInt}},\n  \"status\": \"PENDING\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/stream/publish",
							"host": ["{{base_url}}"],
							"path": ["api", "stream", "publish"]
						}
					}
				}
			]
		},
		{
			"name": "10. Advanced Lettuce (Resilience)",
			"item": [
				{
					"name": "Circuit Breaker Test",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/advanced-lettuce/circuit-breaker?key=test-key",
							"host": ["{{base_url}}"],
							"path": ["api", "advanced-lettuce", "circuit-breaker"],
							"query": [
								{
									"key": "key",
									"value": "test-key"
								}
							]
						}
					}
				},
				{
					"name": "Bulkhead Test",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/advanced-lettuce/bulkhead?key=test-key",
							"host": ["{{base_url}}"],
							"path": ["api", "advanced-lettuce", "bulkhead"],
							"query": [
								{
									"key": "key",
									"value": "test-key"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "11. Health & Metrics",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/actuator/health",
							"host": ["{{base_url}}"],
							"path": ["actuator", "health"]
						}
					}
				},
				{
					"name": "Prometheus Metrics",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/actuator/prometheus",
							"host": ["{{base_url}}"],
							"path": ["actuator", "prometheus"]
						}
					}
				}
			]
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global pre-request script",
					"console.log('Executing request to: ' + pm.request.url);"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global test script",
					"pm.test(\"Response time < 5000ms\", function() {",
					"    pm.expect(pm.response.responseTime).to.be.below(5000);",
					"});",
					"",
					"pm.test(\"Status code is successful\", function() {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
					"});"
				]
			}
		}
	]
}
